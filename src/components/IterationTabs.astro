---
/**
 * Review tool, not part of any design: the design iterations as tabs at the bottom-left, to jump
 * between them quickly. Links (each iteration is its own page), so the browser's own history,
 * middle-click and "open in new tab" keep working. Collapsible; the state is remembered per browser.
 */
export type Iteration = 'a' | 'b0' | 'b1' | 'b2' | 'c' | 'd' | 'd2';
interface Props {
  current: Iteration;
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// `hidden`: kept, but not shown for now. With one visible item there is nothing to switch, so the bar
// is not rendered at all.
const all: { id: Iteration; group: string; label: string; href: string; hidden?: boolean }[] = [
  { id: 'a', group: 'A', label: '3D forest', href: `${base}/proposal-a`, hidden: true },
  { id: 'b0', group: 'B', label: 'Editorial', href: `${base}/proposal-b`, hidden: true },
  { id: 'b1', group: 'B', label: 'Graphics in', href: `${base}/proposal-b/graphics-1`, hidden: true },
  { id: 'b2', group: 'B', label: 'Graphics on', href: `${base}/proposal-b/graphics-2`, hidden: true },
  { id: 'c', group: 'C', label: 'Dark green', href: `${base}/proposal-c`, hidden: true },
  { id: 'd', group: 'D', label: 'Hybrid', href: `${base}/proposal-d`, hidden: true },
  { id: 'd2', group: 'D', label: 'Point field', href: `${base}/` },
];
const items = all.filter((it) => !it.hidden || it.id === current);
---

{
  items.length > 1 && (
<div class="it" data-iterations>
  <button class="toggle" type="button" aria-expanded="true" aria-controls="iteration-list" data-it-toggle>
    <span class="toggle-label">Versions</span>
  </button>
  <nav id="iteration-list" class="list" aria-label="Design iterations">
    {
      items.map((it) => (
        <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>
          <span class="group" aria-hidden="true">
            {it.group}
          </span>
          <span class="visually-hidden">Proposal {it.group}, </span>
          {it.label}
        </a>
      ))
    }
  </nav>
</div>
  )
}

<script>
  const root = document.querySelector<HTMLElement>('[data-iterations]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-it-toggle]');
  if (root && toggle) {
    const KEY = 'af-iterations-open';
    let stored: string | null = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* storage can be unavailable */
    }
    const narrow = window.matchMedia('(max-width: 640px)').matches;
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      root.toggleAttribute('data-closed', !open);
    };
    set(stored ? stored === '1' : !narrow);
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      set(open);
      try {
        localStorage.setItem(KEY, open ? '1' : '0');
      } catch {
        /* ignore */
      }
    });
  }
</script>

<style>
  .it {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 1000;
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: calc(100vw - 32px);
    padding: 4px;
    border-radius: 14px;
    background: rgb(16 18 16 / 0.84);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.08),
      0 12px 32px -12px rgb(0 0 0 / 0.5);
    font-family: 'Manrope Variable', 'Manrope', ui-sans-serif, system-ui, sans-serif;
    letter-spacing: -0.005em;
  }

  .toggle {
    flex: none;
    height: 34px;
    padding: 0 12px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: rgb(255 255 255 / 0.6);
    font-size: 13px;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .it[data-closed] .toggle {
    color: #ffffff;
  }

  .list {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .it[data-closed] .list {
    display: none;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 12px 0 8px;
    border-radius: 10px;
    color: rgb(255 255 255 / 0.66);
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .group {
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.1);
    font-size: 11.5px;
  }

  a[aria-current='page'] {
    background: rgb(255 255 255 / 0.14);
    color: #ffffff;
  }

  a[aria-current='page'] .group {
    background: #b8f27a;
    color: #10200f;
  }

  @media (hover: hover) and (pointer: fine) {
    a:hover,
    .toggle:hover {
      color: #ffffff;
      background: rgb(255 255 255 / 0.08);
    }
  }

  a:focus-visible,
  .toggle:focus-visible {
    outline: 2px solid #b8f27a;
    outline-offset: 1px;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
