---
/** Fixed header; light or dark with the sheet underneath (see header-theme.ts). */
import Logo from '../../components/Logo.astro';
const links = [
  { label: 'Platform', href: '#platform' },
  { label: 'ForestLayer', href: '#forestlayer' },
  { label: 'Stories', href: '#stories' },
  { label: 'For whom', href: '#for-whom' },
];
---

<header class="header" data-header data-theme="light">
  <div class="pd-cols" aria-hidden="true"></div>
  <div class="pd-wrap bar">
    <a class="brand" href="#top" aria-label="AboveForest, top of the page"><Logo class="logo" /></a>
    <nav class="nav" aria-label="Main">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <a class="pd-btn pd-btn-solid cta" href="#access">Request early access</a>
  </div>
</header>

<style>
  .header {
    --bg: rgb(242 243 245 / 0.72);
    --fg: var(--ink);
    --fg-2: var(--ink-2);
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: var(--bg);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    color: var(--fg);
    --line: rgb(17 26 20 / 0.09);
    transition:
      background-color 300ms ease,
      color 300ms ease,
      transform 420ms var(--ease);
  }

  /* Hidden while reading down, back as soon as you scroll up. It is fixed, so nothing below moves. */
  .header[data-hidden] {
    transform: translateY(-100%);
  }

  .header:focus-within {
    transform: none;
  }

  /* The page's column lines run through the header too. */
  .header :global(.pd-cols) {
    z-index: 0;
  }

  .bar {
    position: relative;
    z-index: 1;
  }

  .header[data-theme='dark'] {
    --line: rgb(238 240 236 / 0.09);
    --bg: rgb(13 14 15 / 0.62);
    --fg: var(--on-night);
    --fg-2: var(--on-night-2);
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
  }

  .brand {
    justify-self: start;
    padding-left: var(--cell);
  }

  .brand :global(.logo) {
    display: block;
    width: 132px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: 14.5px;
    font-weight: 500;
  }

  .nav a {
    color: var(--fg-2);
    text-decoration: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--fg);
    }
  }

  .cta {
    justify-self: end;
    height: 38px;
    margin-right: var(--cell);
    font-size: 14px;
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .bar {
      grid-template-columns: 1fr auto;
    }
  }
</style>
