---
/**
 * Fixed header; light or dark with the sheet underneath (see header-theme.ts). No box: behind it the
 * page blurs and tints most at the top and less on the way down, fading out below the bar, so the
 * grid lines and content pass softly under it.
 */
import Logo from '../../components/Logo.astro';
const links = [
  { label: 'Platform', href: '#platform' },
  { label: 'ForestLayer', href: '#forestlayer' },
  { label: 'Stories', href: '#stories' },
  { label: 'For whom', href: '#for-whom' },
];
---

<header class="header" data-header data-theme="light">
  <div class="veil" aria-hidden="true"><i></i><i></i><i></i></div>
  <div class="pd-wrap bar">
    <a class="brand" href="#top" aria-label="AboveForest, top of the page"><Logo class="logo" /></a>
    <nav class="nav" aria-label="Main">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <a class="pd-btn pd-btn-primary cta" href="#access">Request early access</a>
  </div>
</header>

<style>
  .header {
    --tint: 242 243 245;
    --fg: var(--ink);
    --fg-2: var(--ink-2);
    --fade: 120px;
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    color: var(--fg);
    transition:
      color 300ms ease,
      transform 420ms var(--ease);
  }

  .header[data-theme='dark'] {
    --tint: 13 14 15;
    --fg: var(--on-night);
    --fg-2: var(--on-night-2);
  }

  /* Hidden while reading down, back as soon as you scroll up. It is fixed, so nothing below moves. */
  .header[data-hidden] {
    transform: translateY(calc(-1 * var(--fade)));
  }

  .header:focus-within {
    transform: none;
  }

  /* A progressive blur: three layers, each blurring more and reaching less far down, under a tint that
   * eases out (many stops, so no visible step). Taller than the bar, so it ends below it. */
  .veil {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: var(--fade);
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      rgb(var(--tint) / 0.82) 0%,
      rgb(var(--tint) / 0.74) 18%,
      rgb(var(--tint) / 0.6) 34%,
      rgb(var(--tint) / 0.43) 48%,
      rgb(var(--tint) / 0.27) 61%,
      rgb(var(--tint) / 0.14) 73%,
      rgb(var(--tint) / 0.06) 84%,
      rgb(var(--tint) / 0.015) 93%,
      rgb(var(--tint) / 0) 100%
    );
    transition: background-color 300ms ease;
  }

  .veil i {
    position: absolute;
    inset: 0;
  }

  .veil i:nth-child(1) {
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 100%);
  }

  .veil i:nth-child(2) {
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    mask-image: linear-gradient(to bottom, #000 25%, transparent 72%);
    -webkit-mask-image: linear-gradient(to bottom, #000 25%, transparent 72%);
  }

  .veil i:nth-child(3) {
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 52%);
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 52%);
  }

  .bar {
    position: relative;
    z-index: 1;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 64px;
  }

  .brand {
    justify-self: start;
    padding-left: var(--cell);
  }

  .brand :global(.logo) {
    display: block;
    width: 132px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 28px;
    font-size: 14.5px;
    font-weight: 500;
  }

  .nav a {
    color: var(--fg-2);
    text-decoration: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--fg);
    }
  }

  .cta {
    justify-self: end;
    height: 38px;
    margin-right: var(--cell);
    font-size: 14px;
  }

  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .bar {
      grid-template-columns: 1fr auto;
    }
  }
</style>
