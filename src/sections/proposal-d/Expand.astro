---
/**
 * The bridge from the problem to the platform: the forest from above starts as a frame in the middle
 * two columns of the grid and grows until it fills the screen; then the photograph dims and the
 * product arrives: the title fades in centred on top, and the AboveForest app slides up from the
 * bottom edge, as wide as the grid, cropped by the bottom of the screen. Scroll-scrubbed (see
 * expand.ts); with reduced motion it is the dimmed photograph with the line and the app, still.
 */
const base = `${import.meta.env.BASE_URL}proposal-d/`;
const set = (name: string) => ({
  src: `${base}${name}-1200.webp`,
  srcset: `${base}${name}-1200.webp 1200w, ${base}${name}-2400.webp 2400w`,
});
const canopy = set('canopy');
const app = set('app-1');
---

<section class="pd-section pd-dark expand" id="platform" data-expand data-theme="dark">
  <div class="sticky">
    <div class="pd-cols" aria-hidden="true"></div>
    <div class="frame" data-frame>
      <div class="img">
        <img class="photo" src={canopy.src} srcset={canopy.srcset} sizes="100vw" alt="" width="2400" height="1343" loading="eager" decoding="async" />
      </div>
      <div class="shade" aria-hidden="true"></div>
    </div>

    <div class="glow" aria-hidden="true"></div>
    <div class="pd-wrap over" data-over>
      <h2 class="pd-h2 head">See your forest come alive</h2>
      <figure class="app">
        <img
          src={app.src}
          srcset={app.srcset}
          sizes="(max-width: 1376px) 96vw, 1320px"
          alt="The AboveForest app: a forest map with a stand outlined in lime, the list of stands on the left and the stand's summary on the right."
          width="2400"
          height="1350"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

<style>
  .expand {
    --line: rgb(238 240 236 / 0.075);
    /* The air around the title and the app. */
    --air: clamp(20px, 4svh, 48px);
    height: 320svh;
  }

  .sticky {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  /* The script sets the inset; without it (or with reduced motion) the photo is full screen. */
  .frame {
    position: absolute;
    inset: 0;
    z-index: 1;
    clip-path: inset(var(--t, 0px) var(--r, 0px) var(--b, 0px) var(--l, 0px) round var(--rad, 0px));
    will-change: clip-path;
  }

  .img {
    position: absolute;
    inset: 0;
    transform: scale(var(--zoom, 1));
    transform-origin: 50% 50%;
  }

  .photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain);
    background-size: 180px;
    mix-blend-mode: overlay;
    opacity: 0.25;
  }

  /* The photograph dims as the product arrives. */
  .shade {
    position: absolute;
    inset: 0;
    background: rgb(13 14 15);
    opacity: calc(0.15 + var(--over, 1) * 0.62);
  }

  /* ── The title and the app ── */
  /* A column: the title centred on top, the app below it at the full width of the grid, running off
     the bottom of the screen (cropped there). */
  .over {
    position: absolute;
    left: 0;
    right: 0;
    top: 64px;
    bottom: 0;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: var(--air);
    padding-top: var(--air);
    pointer-events: none;
  }

  .head {
    flex: none;
    max-width: 18ch;
    margin: 0 auto;
    color: var(--on-night);
    text-align: center;
    text-wrap: balance;
    opacity: var(--over, 1);
    transform: translateY(calc((1 - var(--over, 1)) * 24px));
  }

  /* When the app is shorter than the space (phones), it sits on the bottom edge all the same. */
  /* A soft lime light rising behind the app. Its own layer, wider than the screen and fading to zero
     at its own edges (closest-side), so no box edge ever shows; eased stops and grain, so no bands. */
  .glow {
    position: absolute;
    left: 50%;
    bottom: -38svh;
    z-index: 2;
    width: 130vw;
    height: 110svh;
    translate: -50% 0;
    background: radial-gradient(
      closest-side,
      rgb(184 242 122 / 0.2) 0%,
      rgb(184 242 122 / 0.17) 14%,
      rgb(170 230 110 / 0.125) 30%,
      rgb(140 200 90 / 0.08) 46%,
      rgb(111 155 69 / 0.045) 61%,
      rgb(80 120 50 / 0.02) 75%,
      rgb(50 80 30 / 0.006) 88%,
      rgb(35 51 26 / 0) 100%
    );
    opacity: var(--app, 1);
    pointer-events: none;
  }

  .glow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--grain);
    background-size: 180px;
    mix-blend-mode: overlay;
    opacity: 0.35;
    mask-image: radial-gradient(closest-side, #000, transparent);
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
  }

  .app {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    margin: 0;
    overflow: hidden;
  }

  /* Rises from below the bottom edge; top corners rounded like the app's own. */
  .app img {
    display: block;
    flex: none;
    margin-top: auto;
    width: 100%;
    height: auto;
    border-radius: 12px 12px 0 0;
    box-shadow: 0 0 0 1px rgb(238 240 236 / 0.1);
    transform: translateY(calc((1 - var(--app, 1)) * 100%));
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .expand {
      height: 100svh;
    }
  }
</style>
