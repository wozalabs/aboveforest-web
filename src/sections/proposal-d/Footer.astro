---
/**
 * Footer on the grid: brand and three link columns, then the wordmark, cut by the bottom of the page,
 * over the brand greens rising from the bottom edge like a horizon.
 */
import Logo from '../../components/Logo.astro';
const year = new Date().getFullYear();
const columns = [
  { title: 'Product', links: [['Platform', '#platform'], ['ForestLayer', '#forestlayer'], ['Stories', '#stories'], ['For whom', '#for-whom']] },
  { title: 'Company', links: [['Woza Labs', 'https://wozalabs.com'], ['Request access', '#access']] },
  { title: 'Legal', links: [['Legal', '#'], ['Privacy', '#'], ['Support', '#']] },
];
---

<footer class="pd-section pd-dark pd-cover footer" data-theme="dark">
  <div class="pd-cols" aria-hidden="true"></div>
  <div class="pd-wrap">
    <div class="pd-grid top">
      <div class="pd-cell brand">
        <Logo class="logo" />
        <p class="pd-body">Forest intelligence infrastructure.</p>
      </div>
      {
        columns.map((c) => (
          <nav class="pd-cell col" aria-label={c.title}>
            <p class="pd-label">{c.title}</p>
            {c.links.map(([label, href]) => (
              <a href={href}>{label}</a>
            ))}
          </nav>
        ))
      }
    </div>
    <div class="pd-grid legal pd-rule">
      <p class="pd-cell pd-label span-4">© {year} AboveForest and ForestLayer by Woza Labs.</p>
    </div>
  </div>
  <p class="word" aria-hidden="true"><span>AboveForest</span></p>
</footer>

<style>
  .footer {
    position: relative;
    overflow: hidden;
    padding-top: clamp(72px, 9vw, 112px);
    background: #0a0b0c;
  }

  .top {
    row-gap: 40px;
    padding-bottom: 64px;
  }

  .brand {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .brand :global(.logo) {
    width: 150px;
    height: auto;
  }

  .col {
    display: grid;
    align-content: start;
    gap: 10px;
    font-size: 15px;
    font-weight: 500;
  }

  .col .pd-label {
    margin-bottom: 6px;
  }

  .col a {
    width: fit-content;
    color: var(--fg-2);
    text-decoration: none;
    transition: color 160ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .col a:hover {
      color: var(--fg);
    }
  }

  .legal {
    padding-top: 20px;
  }

  /* The horizon: the same ramp as the colour wipe between dark and light sections (ground, dark
   * green, green, lime), rising from the bottom edge across the whole width, so it has no sides.
   * Mixed in Oklab with eased stops, and a fine grain over it, so it never shows bands. */
  .footer::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    height: min(36vw, 520px);
    background: linear-gradient(
      to bottom,
      rgb(10 11 12 / 0) 0%,
      rgb(14 19 13 / 0.6) 16%,
      #121a10 28%,
      #1a2814 40%,
      #23331a 51%,
      #34502a 62%,
      #4f7836 72%,
      #6f9b45 81%,
      #95c95f 90%,
      #b8f27a 97%,
      #c9f59a 100%
    );
    background: linear-gradient(
      in oklab to bottom,
      rgb(10 11 12 / 0) 0%,
      rgb(14 19 13 / 0.6) 16%,
      #121a10 28%,
      #1a2814 40%,
      #23331a 51%,
      #34502a 62%,
      #4f7836 72%,
      #6f9b45 81%,
      #95c95f 90%,
      #b8f27a 97%,
      #c9f59a 100%
    );
    pointer-events: none;
  }

  /* Grain over the horizon only, to dither the dark end of the ramp. */
  .footer::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    height: min(36vw, 520px);
    background: var(--grain);
    background-size: 160px;
    mix-blend-mode: overlay;
    opacity: 0.5;
    mask-image: linear-gradient(to bottom, transparent, #000 40%);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 40%);
    pointer-events: none;
  }

  .footer > :not(.pd-cols) {
    position: relative;
    z-index: 2;
  }

  /* The giant wordmark: centred on the page (a centred flex row overflows evenly on both sides),
   * a shade lighter than the ground, cut by the bottom edge. A detail, not a headline. */
  .word {
    display: flex;
    justify-content: center;
    margin: 40px 0 -0.2em;
    color: #0a0b0c;
    font-size: 16.6vw;
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 1;
    white-space: nowrap;
    user-select: none;
  }

  .word span {
    flex: none;
    /* Negative tracking pulls the box in after the last letter, so the letters sit 0.03em right of
     * the box's centre; nudge them back. */
    transform: translateX(-0.03em);
  }
</style>
