---
/**
 * The dark 3D opening (the primary page), on #0D0E0F with the lime accent: tens of thousands of
 * points rise into a forest seen from above, then resolve into a map of stands as you scroll
 * (hero-field.ts); each stand is numbered, and picking one opens its panel. The first sheet slides over the stage during the
 * last screen of scroll. The copy is real HTML; the canvas fades in when ready, and without WebGL the
 * stage is simply black.
 */
import { STANDS } from '../../data/stands';
interface Props {
  kind: 'field';
}
const { kind } = Astro.props;
const captions = {
  field: ['Every tree, mapped from above', 'Pick a numbered area to see its trees'],
};
const pad = (n: number) => String(n).padStart(2, '0');
const fmt = (n: number, d = 1) => n.toLocaleString('en-GB', { minimumFractionDigits: d, maximumFractionDigits: d });
---

<section class={`hero hero-${kind}`} id="top" data-hero-dark={kind} data-theme="dark" aria-label="AboveForest">
  <div class="stage" data-stage>
    <div class="canvas" data-canvas-host></div>
    <div class="shade" aria-hidden="true"></div>
    <div class="pd-cols" aria-hidden="true"></div>

    <div class="pd-wrap copy" data-copy>
      <h1 class="title" data-reveal>The operating system for Earth's forests</h1>
      <p class="pd-lead lead" data-reveal="lines">
        Forests become data. Data becomes infrastructure, enabling monitoring, MRV, and climate action at planetary scale.
      </p>
      <div class="pd-actions actions">
        <a class="pd-btn pd-btn-primary" href="#access">Request early access</a>
        <a class="pd-btn pd-btn-secondary" href="#platform">Explore the platform</a>
      </div>
    </div>

    {
      captions[kind].map((c, i) => (
        <p class="caption" data-caption={i} aria-hidden="true">
          {c}
        </p>
      ))
    }
    <p class="hint" data-hint aria-hidden="true">Scroll</p>

    <!-- Numbers over the stands (hero-field.ts places them) and the panel a click opens. -->
    <div class="labels" aria-label="Stands">
      {
        STANDS.map((st, i) => (
          <button class="label" type="button" data-stand={i} tabindex="-1" aria-label={`Stand ${pad(i + 1)}, ${st.species}`}>
            {pad(i + 1)}
          </button>
        ))
      }
    </div>

    <div class="pd-wrap panel-wrap">
      <div class="pd-grid">
        <aside class="pd-cell span-2 panel" data-stand-panel aria-live="polite">
          <div class="panel-head">
            <p class="panel-num" data-f="num"></p>
            <div>
              <p class="panel-id" data-f="id"></p>
              <p class="panel-name" data-f="species"></p>
              <p class="panel-latin" data-f="latin"></p>
            </div>
            <button class="panel-close" type="button" data-close aria-label="Close">
              <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            </button>
          </div>
          <div class="panel-body">
            <div class="panel-area">
              <p class="panel-big"><span data-f="area"></span><small>ha</small></p>
              <div class="share" aria-hidden="true"><i></i></div>
              <p class="share-legend"><span><b data-f="share"></b> <span data-f="type"></span></span><span data-f="rest"></span></p>
            </div>
            <dl class="panel-data">
              <div><dt>Trees</dt><dd data-f="trees"></dd></div>
              <div><dt>Mean height</dt><dd data-f="height"></dd></div>
              <div><dt>Carbon</dt><dd data-f="carbon"></dd></div>
            </dl>
          </div>
        </aside>
      </div>
    </div>

    <!-- The same figures for screen readers and search engines. -->
    <div class="visually-hidden">
      <h2>Stands on the map</h2>
      <ul>
        {
          STANDS.map((st) => (
            <li>
              {st.id}: {st.species} ({st.latin}), {st.type.toLowerCase()} {st.share}%, {fmt(st.area, 2)} ha,{' '}
              {fmt(st.trees, 0)} trees, mean height {fmt(st.height)} m, {fmt(st.carbon, 0)} t CO₂e.
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Long enough to linger on the grid and its trees before the next sheet comes. */
  .hero {
    --bg: var(--night);
    --fg: var(--on-night);
    --fg-2: var(--on-night-2);
    --line: rgb(238 240 236 / 0.06);
    --reveal: var(--lime);
    position: relative;
    height: 300svh;
    background: var(--bg);
    color: var(--fg);
  }

  .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .canvas,
  .canvas :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .canvas :global(canvas) {
    opacity: 0;
    transition: opacity 1200ms var(--ease);
  }

  .hero[data-ready] .canvas :global(canvas) {
    opacity: 1;
  }

  /* Keep the copy legible over the points: a soft dark pool behind it. */
  .shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(52% 40% at 50% 52%, rgb(13 14 15 / 0.92), rgb(13 14 15 / 0.7) 50%, rgb(13 14 15 / 0.25) 80%, transparent 100%),
      linear-gradient(to top, rgb(13 14 15 / 0.65), transparent 30%);
    opacity: var(--copy, 1);
    pointer-events: none;
  }

  /* Centred and large: the headline in the middle of the screen, the rest beneath it. */
  .copy {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: clamp(20px, 2.6vw, 32px);
    padding-top: 40px;
    text-align: center;
    pointer-events: none;
  }

  .copy > * {
    pointer-events: auto;
  }

  .title {
    max-width: 16ch;
    font-size: clamp(40px, 5.2vw, 84px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .lead {
    max-width: 46ch;
  }

  .actions {
    justify-content: center;
  }

  .caption {
    position: absolute;
    left: 50%;
    bottom: 56px;
    z-index: 2;
    padding: 9px 18px;
    border-radius: 12px;
    background: rgb(13 14 15 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(184 242 122 / 0.25);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    color: var(--on-night);
    font-size: clamp(16px, 1.4vw, 20px);
    font-weight: 500;
    letter-spacing: -0.02em;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 8px);
    transition:
      opacity 500ms ease,
      transform 700ms var(--ease);
    pointer-events: none;
  }

  .caption[data-on] {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .hint {
    position: absolute;
    right: calc(max(var(--pd-pad), (100% - var(--pd-max)) / 2) + var(--cell));
    bottom: 68px;
    z-index: 2;
    color: var(--fg-2);
    font-size: 13.5px;
    font-weight: 500;
  }

  /* ── Stand numbers: small tags pinned to each stand's centre, shown once the map is up ── */
  .labels {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .label {
    position: absolute;
    left: 0;
    top: 0;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    min-width: 28px;
    height: 22px;
    padding: 0 6px;
    border: 0;
    border-radius: 7px;
    background: rgb(13 14 15 / 0.72);
    box-shadow: inset 0 0 0 1px rgb(238 240 236 / 0.14);
    color: var(--on-night-2);
    font: inherit;
    font-size: 11.5px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 400ms ease,
      background-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .hero[data-map] .label {
    opacity: 1;
    pointer-events: auto;
  }

  .label[data-hover] {
    color: var(--on-night);
    box-shadow: inset 0 0 0 1px rgb(184 242 122 / 0.5);
  }

  .label[data-active] {
    background: var(--lime);
    box-shadow: none;
    color: var(--lime-ink);
  }

  .label:focus-visible {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  /* ── The panel: bottom left, two grid columns wide, inside the grid ── */
  .panel-wrap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--cell);
    z-index: 3;
    pointer-events: none;
  }

  /* Its edges sit on the column lines. */
  .panel {
    padding: 18px 20px 20px;
    border-radius: 12px;
    background: rgb(13 14 15 / 0.82);
    box-shadow:
      inset 0 0 0 1px rgb(184 242 122 / 0.16),
      0 30px 60px -30px rgb(0 0 0 / 0.9);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: var(--on-night);
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 260ms ease,
      transform 500ms var(--ease);
  }

  .panel[data-on] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .panel-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: start;
    gap: 14px;
  }

  .panel-num {
    display: grid;
    place-items: center;
    min-width: 38px;
    height: 32px;
    padding: 0 8px;
    border-radius: 8px;
    background: var(--lime);
    color: var(--lime-ink);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .panel-id {
    color: var(--on-night-3);
    font-size: 12.5px;
    font-weight: 500;
  }

  .panel-name {
    margin-top: 2px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .panel-latin {
    color: var(--on-night-2);
    font-size: 13.5px;
  }

  .panel-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: rgb(238 240 236 / 0.06);
    color: var(--on-night-2);
    cursor: pointer;
    transition:
      background-color 160ms ease,
      color 160ms ease;
  }

  .panel-close:hover {
    background: rgb(238 240 236 / 0.12);
    color: var(--on-night);
  }

  .panel-body {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 24px;
    margin-top: 18px;
  }

  .panel-big {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: clamp(32px, 3vw, 44px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }

  .panel-big small {
    color: var(--on-night-2);
    font-size: 15px;
    letter-spacing: -0.01em;
  }

  .share {
    height: 6px;
    margin-top: 16px;
    border-radius: 3px;
    background: rgb(238 240 236 / 0.1);
    overflow: hidden;
  }

  .share i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: var(--lime);
    transform-origin: left;
    transform: scaleX(var(--share, 0));
    transition: transform 700ms var(--ease);
  }

  .share-legend {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--on-night-2);
    font-size: 12.5px;
  }

  .share-legend b {
    color: var(--on-night);
    font-weight: 600;
  }

  .panel-data {
    display: grid;
    align-content: end;
    gap: 8px;
    margin: 0;
    font-size: 13.5px;
  }

  .panel-data div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }

  .panel-data dt {
    color: var(--on-night-2);
  }

  .panel-data dd {
    margin: 0;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* The caption makes way for the panel. */
  .hero[data-picked] .caption {
    opacity: 0;
  }

  /* The map takes the pointer once it is there. */
  .hero[data-map] .stage {
    cursor: crosshair;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .title {
      max-width: 9ch;
    }
    .caption {
      bottom: 72px;
    }
    .panel-wrap {
      bottom: 72px;
    }
    .panel {
      padding: 14px 16px 16px;
    }
    .panel-body {
      grid-template-columns: 1fr;
      gap: 14px;
      margin-top: 12px;
    }
    .panel-latin {
      display: none;
    }
    .label {
      min-width: 22px;
      height: 18px;
      font-size: 10px;
    }
  }
</style>
