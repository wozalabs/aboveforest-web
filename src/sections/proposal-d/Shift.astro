---
/** The shift (dark tone), as a ruled table: what changes, and what it replaces. A chestnut turns beside the heading. */
const pairs = [
  { now: 'One protocol. Total interoperability.', before: 'Siloed data in incompatible formats.' },
  { now: 'Carbon from actual tree-level biometrics.', before: 'Carbon from lookup tables and estimates.' },
  { now: 'Compliance as a byproduct of operations.', before: 'Compliance as paperwork theatre.' },
  { now: 'Real-time deforestation alerts.', before: 'Illegal logging detected after the fact.' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="shift" data-tone="dark" data-theme="dark">
  <div class="pd-wrap pd-pad">
    <div class="pd-grid head">
      <h2 class="pd-h2 pd-cell span-2" data-reveal>The old way is over</h2>
      <div class="pd-cell span-2 tree-cell">
        <div class="pd-tree" data-tree="tree-castano" data-ground="dark" aria-hidden="true"></div>
      </div>
    </div>
    <table class="table">
      <thead>
        <tr class="pd-grid">
          <th class="pd-cell pd-label" scope="col"><span class="sr">Number</span></th>
          <th class="pd-cell pd-label span-2" scope="col">With AboveForest</th>
          <th class="pd-cell pd-label" scope="col">Before</th>
        </tr>
      </thead>
      <tbody>
        {
          pairs.map((p, i) => (
            <tr class="pd-grid pd-rule">
              <td class="pd-cell pd-label">{pad(i + 1)}</td>
              <td class="pd-cell span-2 now" data-reveal>
                {p.now}
              </td>
              <td class="pd-cell before">{p.before}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>

<style>
  .head {
    align-items: end;
  }

  .tree-cell {
    height: clamp(280px, 30vw, 420px);
  }

  .table {
    width: 100%;
    margin-top: clamp(32px, 4vw, 56px);
    border-collapse: collapse;
  }

  th {
    padding-bottom: 14px;
    text-align: left;
  }

  td {
    padding-block: 26px;
  }

  .now {
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .before {
    color: var(--fg-3);
    font-size: 15px;
    text-decoration: line-through;
    text-decoration-color: var(--line);
  }

  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .tree-cell {
      height: 300px;
    }
    thead {
      display: none;
    }
    tr.pd-grid {
      grid-template-columns: 1fr;
    }
    td {
      padding-block: 6px;
    }
    td:first-child {
      padding-top: 22px;
    }
    td:last-child {
      padding-bottom: 22px;
    }
  }
</style>
