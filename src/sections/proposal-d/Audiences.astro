---
/** Who it is for (light tone): an oak turning in the first column, the three audiences in the rest. */
const groups = [
  {
    title: 'National governments',
    body: 'Ministries of environment, forestry agencies and land-use planning bodies that need sovereign control over forest intelligence.',
  },
  {
    title: 'Regional authorities',
    body: 'State, provincial and municipal governments managing fire risk, conservation and sustainable development across territories.',
  },
  {
    title: 'International bodies',
    body: 'UN agencies, development banks, climate funds and NGOs that need transparent, verifiable data to deploy capital and enforce commitments.',
  },
];
const frameworks = ['EUDR', 'REDD+', 'CSRD', 'TCFD', 'FSC'];
---

<section class="audiences" id="for-whom" data-tone="light" data-theme="light">
  <div class="pd-wrap pd-pad">
      <div class="pd-grid">
        <h2 class="pd-h2 pd-cell span-2" data-reveal>Built for those who govern forests</h2>
      </div>
      <div class="pd-grid cols">
        <div class="pd-cell tree-cell">
          <div class="pd-tree" data-tree="tree-roble" aria-hidden="true"></div>
        </div>
        {
          groups.map((g) => (
            <article class="pd-cell group">
              <h3 class="pd-h4">{g.title}</h3>
              <p class="pd-body">{g.body}</p>
              <a class="pd-btn" href="#access">
                Talk to us
              </a>
            </article>
          ))
        }
      </div>
      <div class="pd-grid frameworks pd-rule">
        <p class="pd-cell pd-label">Reports ready for</p>
        <ul class="pd-cell span-3 items">{frameworks.map((f) => <li>{f}</li>)}</ul>
      </div>
  </div>
</section>

<style>
  .cols {
    margin-top: clamp(56px, 7vw, 96px);
    row-gap: 40px;
  }

  .tree-cell {
    min-height: 380px;
  }

  .group {
    display: grid;
    grid-template-rows: auto 1fr auto;
    justify-items: start;
    gap: 12px;
  }

  .group .pd-btn {
    margin-top: 16px;
  }

  .frameworks {
    align-items: baseline;
    margin-top: clamp(56px, 7vw, 96px);
    padding-top: 22px;
    row-gap: 10px;
  }

  .items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 32px;
    font-size: clamp(22px, 2.2vw, 32px);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  @media (max-width: 900px) {
    .tree-cell {
      grid-column: 1 / -1;
      min-height: 300px;
    }
  }

  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
