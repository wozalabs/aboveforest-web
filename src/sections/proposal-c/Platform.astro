---
/**
 * The platform: the hill at dusk, the first module in words and a Live Territory panel in glass.
 * Pinned: the capabilities slide over it.
 */
import Photo from './Photo.astro';
import Mark from './Mark.astro';
const others = ['Multi-Source Intelligence', 'Management Engine', 'Risk & Climate Modeling', 'Automated Compliance'];
const rows = [
  { name: 'Species', w: 0.78 },
  { name: 'Height', w: 0.56 },
  { name: 'Diameter', w: 0.64 },
  { name: 'Health', w: 0.86 },
];
const base = `${import.meta.env.BASE_URL}proposal-c/`;
---

<section class="pc-section platform" id="platform" data-pin>
  <div class="pin-inner">
    <Photo name="hill" position="50% 40%" />
    <div class="shade" aria-hidden="true"></div>
    <div class="pc-wrap pc-pad grid">
      <div class="copy">
        <h2 class="pc-serif pc-d2" data-reveal>See your forest come alive</h2>
        <p class="pc-lead">
          Your entire forest as a navigable digital twin. Every tree geolocated with species, height, diameter and health.
          Built from fused satellite imagery, LiDAR and field data. Updated continuously, not once a decade.
        </p>
        <ul class="pc-tags" aria-label="Also in the platform">{others.map((m) => <li>{m}</li>)}</ul>
      </div>

      <div class="panel pc-glass" aria-label="Live Territory, interface preview" role="img">
        <div class="panel-top">
          <span class="panel-mark"><Mark /></span>
          <span class="panel-title">Live Territory</span>
          <span class="live"><span class="pulse"></span>Live</span>
        </div>
        <div class="map">
          <img src={`${base}forest-night-1200.webp`} alt="" loading="lazy" decoding="async" width="1200" height="672" />
          <span class="pin p1"></span>
          <span class="pin p2"></span>
          <span class="pin p3 on"></span>
          <span class="pin p4"></span>
          <span class="ring"></span>
        </div>
        <div class="tree">
          <p class="tree-name">Selected tree</p>
          {
            rows.map((r) => (
              <div class="row">
                <span>{r.name}</span>
                <span class="bar">
                  <span style={`transform: scaleX(${r.w})`} />
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
  <div class="pin-shade"></div>
</section>

<style>
  .platform {
    min-height: max(100svh, 760px);
  }

  .pin-inner {
    display: grid;
    align-items: center;
    background: var(--pc-dark);
  }

  .shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(8 20 14 / 0.88) 0%, rgb(8 20 14 / 0.55) 45%, rgb(8 20 14 / 0.15) 100%),
      linear-gradient(180deg, rgb(8 20 14 / 0.4), transparent 30%);
  }

  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    align-items: center;
    gap: 48px clamp(40px, 8vw, 120px);
  }

  .copy {
    display: grid;
    gap: 24px;
    max-width: 520px;
  }

  /* ── Panel ── */
  .panel {
    display: grid;
    gap: 12px;
    padding: 12px;
    border-radius: 20px;
  }

  .panel-top {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 4px 0;
  }

  .panel-mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--pc-lime);
    color: var(--pc-lime-ink);
  }

  .panel-mark :global(svg) {
    width: 14px;
  }

  .panel-title {
    flex: 1;
    font-size: 14.5px;
    font-weight: 500;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--pc-ink-2);
    font-size: 12.5px;
  }

  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pc-lime);
    animation: pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .map {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
  }

  .map img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) brightness(0.85);
  }

  .pin {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(238 242 234 / 0.8);
    box-shadow: 0 0 0 3px rgb(238 242 234 / 0.2);
  }

  .pin.on {
    background: var(--pc-lime);
    box-shadow: 0 0 0 4px rgb(184 242 122 / 0.3);
  }

  .p1 {
    left: 22%;
    top: 58%;
  }
  .p2 {
    left: 38%;
    top: 40%;
  }
  .p3 {
    left: 58%;
    top: 52%;
  }
  .p4 {
    left: 76%;
    top: 34%;
  }

  .ring {
    position: absolute;
    left: calc(58% + 4px);
    top: calc(52% + 4px);
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(184 242 122 / 0.6);
    animation: ring 3s var(--pc-ease) infinite;
  }

  @keyframes ring {
    from {
      transform: scale(0.3);
      opacity: 1;
    }
    to {
      transform: scale(1.2);
      opacity: 0;
    }
  }

  .tree {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: 12px;
    background: rgb(5 14 10 / 0.35);
  }

  .tree-name {
    font-size: 13.5px;
    font-weight: 500;
  }

  .row {
    display: grid;
    grid-template-columns: 76px 1fr;
    align-items: center;
    gap: 12px;
    color: var(--pc-ink-2);
    font-size: 12.5px;
  }

  .bar {
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(238 242 234 / 0.12);
  }

  .bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgb(184 242 122 / 0.5), var(--pc-lime));
    transform-origin: left;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .shade {
      background: linear-gradient(180deg, rgb(8 20 14 / 0.8), rgb(8 20 14 / 0.55));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pulse,
    .ring {
      animation: none;
    }
  }
</style>
