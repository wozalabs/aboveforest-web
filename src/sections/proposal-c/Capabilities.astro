---
/**
 * Capabilities in two tabs, Measure and Act, each a grid of cards with a small interface sketch.
 * Slides over the pinned platform.
 */
type Viz = 'dots' | 'layers' | 'rings' | 'alert' | 'contour' | 'doc' | 'branch' | 'pulse';
const tabs: { id: string; label: string; items: { title: string; body: string; viz: Viz }[] }[] = [
  {
    id: 'measure',
    label: 'Measure',
    items: [
      { title: 'Individual tree detection', body: 'Species, trunk diameter, height and crown, from remote sensing.', viz: 'dots' },
      { title: '3D forest reconstruction', body: 'Point clouds turned into navigable digital environments.', viz: 'layers' },
      { title: 'Carbon stock estimation', body: 'Per-tree allometric models, with their uncertainty.', viz: 'rings' },
      { title: 'Deforestation detection', body: 'Near real-time alerts from Sentinel-2 and radar.', viz: 'alert' },
    ],
  },
  {
    id: 'act',
    label: 'Act',
    items: [
      { title: 'Fire risk modeling', body: 'Fuel load, weather and topography, simulated together.', viz: 'contour' },
      { title: 'Management Engine', body: 'What-if scenarios for policy and management decisions.', viz: 'branch' },
      { title: 'Automated reporting', body: 'CSRD, TCFD, EUDR, REDD+ and FSC reports from live data.', viz: 'doc' },
      { title: 'Real-time alerts', body: 'Illegal logging flagged as it happens, not after the fact.', viz: 'pulse' },
    ],
  },
];
---

<section class="pc-section pc-cover caps" id="capabilities">
  <div class="pc-wrap pc-pad">
    <div class="top">
      <div class="pc-head">
        <h2 class="pc-serif pc-d2" data-reveal>Everything a forest needs to exist digitally</h2>
      </div>
      <div class="tablist" role="tablist" aria-label="Capabilities">
        {
          tabs.map((t, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
            >
              {t.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      tabs.map((t, i) => (
        <div class="panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
          {t.items.map((it, j) => (
            <article class="card" style={`--j: ${j}`}>
              <div class={`viz viz-${it.viz}`} aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
              <h3 class="card-title">{it.title}</h3>
              <p class="pc-small">{it.body}</p>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</section>

<script>
  // Tabs with arrow-key navigation (WAI-ARIA tabs pattern, automatic activation).
  const list = document.querySelector<HTMLElement>('.caps [role="tablist"]');
  if (list) {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        document.getElementById(t.getAttribute('aria-controls')!)!.hidden = !on;
      }
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) {
          e.preventDefault();
          select(tabs[(i + d + tabs.length) % tabs.length], true);
        } else if (e.key === 'Home' || e.key === 'End') {
          e.preventDefault();
          select(tabs[e.key === 'Home' ? 0 : tabs.length - 1], true);
        }
      });
    });
  }
</script>

<style>
  .caps {
    background: var(--pc-dark);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  .tablist {
    display: inline-flex;
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: rgb(238 242 234 / 0.06);
  }

  [role='tab'] {
    height: 36px;
    padding: 0 18px;
    border: 0;
    border-radius: 999px;
    background: none;
    color: var(--pc-ink-2);
    font: inherit;
    font-size: 14.5px;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 200ms ease,
      color 200ms ease;
  }

  [role='tab'][aria-selected='true'] {
    background: var(--pc-lime);
    color: var(--pc-lime-ink);
  }

  .panel {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .panel[hidden] {
    display: none;
  }

  .panel:not([hidden]) .card {
    animation: card-in 600ms var(--pc-ease) both;
    animation-delay: calc(var(--j) * 60ms);
  }

  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .card {
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 12px 12px 22px;
    border-radius: 18px;
    background: var(--pc-dark-2);
  }

  .card-title {
    margin-top: 10px;
    padding-inline: 8px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.3;
  }

  .card .pc-small {
    padding-inline: 8px;
  }

  /* ── Interface sketches: CSS only, no figures. ── */
  .viz {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background:
      radial-gradient(80% 70% at 30% 20%, rgb(184 242 122 / 0.1), transparent 70%),
      #0f2a20;
  }

  .viz span {
    position: absolute;
  }

  /* Dots: a canopy seen from above, three trees picked out. */
  .viz-dots {
    background:
      radial-gradient(circle, rgb(238 242 234 / 0.22) 1.4px, transparent 1.6px) 0 0 / 14px 14px,
      #0f2a20;
  }
  .viz-dots span {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    box-shadow:
      inset 0 0 0 1.5px var(--pc-lime),
      0 0 0 6px rgb(184 242 122 / 0.08);
  }
  .viz-dots span:nth-child(1) {
    left: 22%;
    top: 30%;
  }
  .viz-dots span:nth-child(2) {
    left: 56%;
    top: 52%;
    width: 34px;
    height: 34px;
  }
  .viz-dots span:nth-child(3) {
    left: 74%;
    top: 20%;
    width: 20px;
    height: 20px;
  }

  /* Layers: three stacked sheets, tilted. */
  .viz-layers span {
    left: 20%;
    width: 60%;
    height: 36%;
    border-radius: 10px;
    background: rgb(238 242 234 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(238 242 234 / 0.14);
    transform: perspective(300px) rotateX(55deg) rotateZ(-30deg);
  }
  .viz-layers span:nth-child(1) {
    top: 14%;
    background: rgb(184 242 122 / 0.22);
  }
  .viz-layers span:nth-child(2) {
    top: 32%;
  }
  .viz-layers span:nth-child(3) {
    top: 50%;
  }

  /* Rings: a crown and its uncertainty. */
  .viz-rings span {
    left: 50%;
    top: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .viz-rings span:nth-child(1) {
    width: 38%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgb(184 242 122 / 0.6), rgb(184 242 122 / 0.15));
  }
  .viz-rings span:nth-child(2) {
    width: 56%;
    aspect-ratio: 1;
    box-shadow: inset 0 0 0 1px rgb(184 242 122 / 0.35);
  }
  .viz-rings span:nth-child(3) {
    width: 72%;
    aspect-ratio: 1;
    box-shadow: inset 0 0 0 1px rgb(238 242 234 / 0.1);
  }

  /* Alert: a cleared patch and a notification chip. */
  .viz-alert span:nth-child(1) {
    left: 18%;
    top: 26%;
    width: 64%;
    height: 48%;
    border-radius: 40% 55% 45% 60%;
    background: repeating-linear-gradient(135deg, rgb(238 242 234 / 0.1) 0 6px, transparent 6px 12px);
    box-shadow: inset 0 0 0 1.5px rgb(255 190 120 / 0.7);
  }
  .viz-alert span:nth-child(2) {
    right: 10%;
    top: 12%;
    width: 30%;
    height: 14%;
    border-radius: 999px;
    background: rgb(255 190 120 / 0.85);
  }
  .viz-alert span:nth-child(3) {
    display: none;
  }

  /* Contour: terrain lines with a hot spot. */
  .viz-contour {
    background:
      repeating-radial-gradient(circle at 62% 58%, transparent 0 9px, rgb(238 242 234 / 0.12) 9px 10px),
      #0f2a20;
  }
  .viz-contour span:nth-child(1) {
    left: 52%;
    top: 46%;
    width: 24%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(255 170 90 / 0.8), transparent 70%);
  }
  .viz-contour span:nth-child(n + 2) {
    display: none;
  }

  /* Branch: one decision, three futures. */
  .viz-branch span {
    left: 18%;
    width: 64%;
    height: 10px;
    border-radius: 999px;
    background: rgb(238 242 234 / 0.12);
  }
  .viz-branch span:nth-child(1) {
    top: 28%;
    width: 52%;
    background: var(--pc-lime);
  }
  .viz-branch span:nth-child(2) {
    top: 46%;
    width: 40%;
  }
  .viz-branch span:nth-child(3) {
    top: 64%;
    width: 28%;
  }

  /* Doc: a report page assembling itself. */
  .viz-doc span:nth-child(1) {
    left: 28%;
    top: 14%;
    width: 44%;
    height: 86%;
    border-radius: 8px 8px 0 0;
    background:
      linear-gradient(rgb(17 26 20 / 0.18), rgb(17 26 20 / 0.18)) 14px 18px / 50% 6px no-repeat,
      linear-gradient(rgb(17 26 20 / 0.1), rgb(17 26 20 / 0.1)) 14px 34px / 70% 5px no-repeat,
      linear-gradient(rgb(17 26 20 / 0.1), rgb(17 26 20 / 0.1)) 14px 46px / 60% 5px no-repeat,
      #eef2ea;
  }
  .viz-doc span:nth-child(2) {
    left: 62%;
    top: 22%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--pc-lime);
  }
  .viz-doc span:nth-child(3) {
    display: none;
  }

  /* Pulse: a live signal. */
  .viz-pulse span {
    left: 50%;
    top: 50%;
    width: 16%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }
  .viz-pulse span:nth-child(1) {
    background: var(--pc-lime);
  }
  .viz-pulse span:nth-child(n + 2) {
    box-shadow: inset 0 0 0 1.5px rgb(184 242 122 / 0.5);
    animation: wave 2.8s var(--pc-ease) infinite;
  }
  .viz-pulse span:nth-child(3) {
    animation-delay: 1.4s;
  }

  @keyframes wave {
    to {
      width: 70%;
      opacity: 0;
    }
  }

  @media (max-width: 1000px) {
    .panel {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel:not([hidden]) .card,
    .viz-pulse span {
      animation: none;
    }
  }
</style>
