---
/**
 * The light sheet: what changes, as comparison rows, then two photo cards with interface on top.
 * Slides over the quote.
 */
import Photo from './Photo.astro';
const pairs = [
  { now: 'One protocol. Total interoperability.', before: 'Siloed data in incompatible formats.' },
  { now: 'Carbon from actual tree-level biometrics.', before: 'Carbon from lookup tables and estimates.' },
  { now: 'Compliance as a byproduct of operations.', before: 'Compliance as paperwork theatre.' },
  { now: 'Real-time deforestation alerts.', before: 'Illegal logging detected after the fact.' },
];
const checks = ['Geolocation', 'Due diligence', 'Risk assessment'];
---

<section class="pc-section pc-cover pc-light pc-on-light shift">
  <div class="pc-wrap pc-pad">
    <div class="top">
      <h2 class="pc-serif pc-d2" data-reveal>The old way is over</h2>
      <p class="pc-lead">From field visits and static reports to a forest that reports on itself.</p>
    </div>

    <ol class="rows">
      {
        pairs.map((p) => (
          <li class="row">
            <p class="now pc-serif">{p.now}</p>
            <p class="before">
              <span class="tag">Before</span>
              {p.before}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="duo">
      <article class="card">
        <Photo name="forest-night" sizes="(max-width: 860px) 100vw, 600px" />
        <div class="card-ui alert pc-glass" aria-hidden="true">
          <span class="alert-dot"></span>
          <div>
            <p class="ui-title">Canopy loss detected</p>
            <p class="ui-sub">Sentinel-2 and radar agree</p>
          </div>
          <span class="ui-chip">Review</span>
        </div>
        <div class="card-copy">
          <h3 class="card-title">See it as it happens</h3>
          <p>Near real-time alerts, so illegal logging is stopped, not recorded.</p>
        </div>
      </article>

      <article class="card">
        <Photo name="forest-light" sizes="(max-width: 860px) 100vw, 600px" position="50% 30%" />
        <div class="card-ui checklist pc-paper" aria-hidden="true">
          <p class="ui-title">EUDR shipment</p>
          {
            checks.map((c) => (
              <p class="check">
                <span class="tick">
                  <svg viewBox="0 0 12 12">
                    <path d="M2.5 6.2l2.3 2.3 4.7-5" />
                  </svg>
                </span>
                {c}
              </p>
            ))
          }
        </div>
        <div class="card-copy">
          <h3 class="card-title">Reports that write themselves</h3>
          <p>CSRD, TCFD, EUDR, REDD+ and FSC, assembled from live data.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    align-items: end;
    gap: 24px 64px;
  }

  /* ── Comparison rows: white cards, no rules. ── */
  .rows {
    display: grid;
    gap: 8px;
    margin: clamp(48px, 6vw, 72px) 0 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: 12px 40px;
    padding: 22px 26px;
    border-radius: 18px;
    background: #ffffff;
    box-shadow: 0 1px 2px rgb(17 26 20 / 0.04);
  }

  .now {
    font-size: clamp(22px, 2vw, 28px);
    line-height: 1.15;
  }

  .before {
    display: flex;
    align-items: baseline;
    gap: 12px;
    color: var(--pc-light-ink-2);
    font-size: 15px;
  }

  .tag {
    flex: none;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgb(17 26 20 / 0.06);
    color: var(--pc-light-ink-2);
    font-size: 12.5px;
  }

  /* ── Two photo cards ── */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(72px, 9vw, 120px);
  }

  .card {
    position: relative;
    display: grid;
    align-content: end;
    min-height: clamp(440px, 46vw, 600px);
    overflow: hidden;
    border-radius: 24px;
    color: var(--pc-ink);
    isolation: isolate;
  }

  .card :global(.pc-photo) {
    z-index: -1;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, transparent 40%, rgb(8 20 14 / 0.8));
  }

  .card-copy {
    display: grid;
    gap: 6px;
    padding: 28px;
  }

  .card-copy p {
    max-width: 40ch;
    color: var(--pc-ink-2);
    font-size: 15px;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: clamp(26px, 2.4vw, 34px);
    font-weight: 400;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .card-ui {
    position: absolute;
    top: 28px;
    left: 28px;
  }

  .alert {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 12px 12px 14px;
  }

  .alert-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ffbe78;
    box-shadow: 0 0 0 5px rgb(255 190 120 / 0.25);
  }

  .ui-title {
    font-size: 14px;
    font-weight: 500;
  }

  .ui-sub {
    color: var(--pc-ink-2);
    font-size: 12.5px;
  }

  .ui-chip {
    margin-left: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: #ffffff;
    color: var(--pc-light-ink);
    font-size: 12.5px;
    font-weight: 500;
  }

  .checklist {
    display: grid;
    gap: 10px;
    width: 220px;
    padding: 16px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--pc-light-ink-2);
    font-size: 13.5px;
  }

  .tick {
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--pc-lime);
  }

  .tick svg {
    width: 12px;
    fill: none;
    stroke: var(--pc-lime-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 860px) {
    .top,
    .row,
    .duo {
      grid-template-columns: 1fr;
    }
  }
</style>
