---
import Logo from '../../components/Logo.astro';
const links = [
  { label: 'Platform', href: '#platform' },
  { label: 'Capabilities', href: '#capabilities' },
  { label: 'Stories', href: '#stories' },
  { label: 'For whom', href: '#for-whom' },
];
---

<header class="header">
  <a class="brand" href="#top" aria-label="AboveForest, top of the page"><Logo class="logo" /></a>
  <nav class="nav" aria-label="Main">{links.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
  <a class="pc-btn pc-btn-light cta" href="#access">Request early access</a>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 60px;
    padding: 0 var(--pc-pad);
    background: linear-gradient(180deg, rgb(10 22 16 / 0.72), rgb(10 22 16 / 0.5));
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--pc-line);
  }

  .brand {
    justify-self: start;
    color: var(--pc-ink);
  }

  .brand :global(.logo) {
    width: 128px;
    height: auto;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    padding: 7px 12px;
    border-radius: 999px;
    color: var(--pc-ink-2);
    font-size: 14px;
    text-decoration: none;
    transition: color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--pc-ink);
    }
  }

  .cta {
    justify-self: end;
    height: 34px;
    padding: 0 14px;
    font-size: 13.5px;
  }

  @media (max-width: 820px) {
    .header {
      grid-template-columns: 1fr auto;
    }
    .nav {
      display: none;
    }
  }
</style>
