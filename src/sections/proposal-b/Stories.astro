---
/** Three stories, as Leedlime's step cards: image on top, text below. */
import Placeholder from './Placeholder.astro';
import BrandField from './BrandField.astro';
import type { Look } from './look';
interface Props {
  look?: Look;
}
const { look = 'plain' } = Astro.props;
const art = [
  { mode: 'field', palette: 'day', seed: 5, chip: 'Inventory' },
  { mode: 'horizon', palette: 'dusk', seed: 8, chip: 'MRV' },
  { mode: 'field', palette: 'moss', seed: 11, chip: 'EUDR' },
] as const;
const stories = [
  {
    title: 'National forest inventory',
    body: 'A ministry of environment replaces its decade-old field inventory with a continuously updated digital twin: individual tree detection, species classification and carbon stock at national scale.',
  },
  {
    title: 'Carbon credit verification',
    body: 'A climate fund validates emission reductions using tree-level biometrics and multi-temporal change detection, replacing lookup tables with auditable, per-hectare MRV.',
  },
  {
    title: 'EUDR compliance',
    body: 'A timber exporter generates deforestation-free proof for every shipment: geolocation, due diligence and risk assessment, assembled automatically from live twin data.',
  },
];
---

<section class="pb-section stories" id="stories">
  <h2 class="pb-h2 pb-center heading pb-reveal">Where AboveForest changes the game.</h2>
  <div class="grid">
    {
      stories.map((s, i) => (
        <article class="card pb-reveal" style={`--i: ${i}`}>
          {look === 'g1' ? (
            <BrandField mode={art[i].mode} palette={art[i].palette} seed={art[i].seed} horizon={0.46} class="img img-g">
              <span class="glass glass-light chip story-chip">{art[i].chip}</span>
            </BrandField>
          ) : (
            <Placeholder class="img" ratio="4 / 3" label={`${s.title} image`} />
          )}
          <div class="body">
            <h3 class="pb-h3">{s.title}</h3>
            <p class="pb-body">{s.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .heading {
    max-width: 680px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(48px, 6vw, 72px);
  }

  .card {
    overflow: hidden;
    border-radius: var(--pb-radius);
    background: var(--pb-card);
    box-shadow:
      0 0 0 1px var(--pb-card-line),
      var(--pb-shadow-card);
  }

  .card :global(.img) {
    border-radius: 0;
  }

  .card :global(.img-g) {
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: flex-end;
    padding: 16px;
  }

  .story-chip {
    height: 30px;
  }

  .body {
    display: grid;
    gap: 10px;
    padding: 24px 28px 30px;
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: 1fr;
      max-width: 560px;
      margin-inline: auto;
    }
  }
</style>
