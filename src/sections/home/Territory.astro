---
/**
 * Back in 2D, in light: the first section after the forest. A starting point for the rest of the
 * site; copy is placeholder.
 */
const features = [
  {
    title: 'Tree-level inventory',
    body: 'Species, height, crown and trunk diameter for every tree, from airborne LiDAR and multispectral imagery.',
    art: 'crowns',
  },
  {
    title: 'Carbon you can audit',
    body: 'Biomass and stored carbon per tree, per stand and per estate, with the method and source behind each figure.',
    art: 'bars',
  },
  {
    title: 'Health, week after week',
    body: 'Satellite revisits flag stress, pests and storm damage early, so field teams go where they are needed.',
    art: 'line',
  },
];

// Deterministic crown map for the first card.
const crowns = Array.from({ length: 34 }, (_, i) => {
  const a = i * 2.399;
  const r = 7 + Math.sqrt(i) * 10.5;
  return { x: 120 + Math.cos(a) * r * 1.5, y: 70 + Math.sin(a) * r * 0.9, r: 5 + ((i * 7) % 5) * 1.6, on: i % 9 === 4 };
});
const bars = [38, 52, 46, 64, 58, 76, 70, 88];
const line = [62, 58, 60, 54, 57, 49, 52, 40, 44, 30, 36, 26];
---

<section class="territory" id="platform">
  <div class="container">
    <div class="intro">
      <h2>From one tree to the whole territory.</h2>
      <p>
        The reading you just walked through, repeated for every tree across your estate and kept current. Inventory,
        carbon and forest health stop being a yearly survey and become a query.
      </p>
    </div>

    <div class="cards">
      {
        features.map((f) => (
          <article class="card">
            <div class="art" aria-hidden="true">
              {f.art === 'crowns' && (
                <svg viewBox="0 0 240 140">
                  {crowns.map((c) => (
                    <circle cx={c.x} cy={c.y} r={c.r} class={c.on ? 'on' : ''} />
                  ))}
                </svg>
              )}
              {f.art === 'bars' && (
                <svg viewBox="0 0 240 140">
                  {bars.map((b, i) => (
                    <rect x={22 + i * 26} y={124 - b} width="16" height={b} rx="4" class={i === bars.length - 1 ? 'on' : ''} />
                  ))}
                </svg>
              )}
              {f.art === 'line' && (
                <svg viewBox="0 0 240 140">
                  <path class="area" d={`M20 ${line[0]} ${line.map((v, i) => `L${20 + i * 18.2} ${v}`).join(' ')} L220 124 L20 124 Z`} />
                  <path class="stroke" d={`M20 ${line[0]} ${line.map((v, i) => `L${20 + i * 18.2} ${v}`).join(' ')}`} />
                  <circle class="on" cx={20 + (line.length - 1) * 18.2} cy={line[line.length - 1]} r="4.5" />
                </svg>
              )}
            </div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>

    <div class="cta">
      <h2>See your forest from above.</h2>
      <a class="btn btn-primary" href="#contact">Request a demo</a>
    </div>
  </div>
</section>

<style>
  .territory {
    position: relative;
    padding-block: clamp(72px, 10vw, 140px) clamp(64px, 8vw, 120px);
    background: var(--bg);
  }

  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 24px 64px;
    align-items: end;
  }

  .intro h2 {
    font-size: clamp(36px, 4.6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  .intro p {
    max-width: 480px;
    color: var(--text-secondary);
    font-size: 18px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
  }

  .card {
    padding: 8px 8px 28px;
    border-radius: var(--radius-card);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .art {
    border-radius: calc(var(--radius-card) - 8px);
    background: var(--surface-1);
    aspect-ratio: 240 / 140;
    overflow: hidden;
  }

  .art svg {
    width: 100%;
    height: 100%;
  }

  .art circle,
  .art rect {
    fill: oklch(0.5 0.06 140 / 0.18);
  }

  .art .on {
    fill: var(--accent);
  }

  .art .area {
    fill: oklch(0.5 0.14 132 / 0.1);
  }

  .art .stroke {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .card h3 {
    margin: 24px 16px 0;
    font-size: 21px;
    letter-spacing: -0.025em;
  }

  .card p {
    margin: 8px 16px 0;
    color: var(--text-secondary);
    font-size: 16px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(72px, 9vw, 128px);
    padding: clamp(32px, 4vw, 56px);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .cta h2 {
    font-size: clamp(28px, 3.2vw, 44px);
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  @media (max-width: 900px) {
    .intro {
      grid-template-columns: 1fr;
    }
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
