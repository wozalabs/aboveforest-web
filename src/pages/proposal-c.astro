---
/** Proposal C: dark green, photography and light, stacked sections. */
import ProposalCLayout from '../layouts/ProposalCLayout.astro';
import Header from '../sections/proposal-c/Header.astro';
import Hero from '../sections/proposal-c/Hero.astro';
import Statement from '../sections/proposal-c/Statement.astro';
import Platform from '../sections/proposal-c/Platform.astro';
import Capabilities from '../sections/proposal-c/Capabilities.astro';
import Sources from '../sections/proposal-c/Sources.astro';
import Stories from '../sections/proposal-c/Stories.astro';
import Quote from '../sections/proposal-c/Quote.astro';
import Shift from '../sections/proposal-c/Shift.astro';
import Govern from '../sections/proposal-c/Govern.astro';
import Cta from '../sections/proposal-c/Cta.astro';
import Footer from '../sections/proposal-c/Footer.astro';
---

<ProposalCLayout
  title="AboveForest, the operating system for Earth's forests"
  description="Forests become data. Data becomes infrastructure, enabling monitoring, MRV, and climate action at planetary scale."
>
  <Header />
  <main>
    <Hero />
    <Statement />
    <Platform />
    <Capabilities />
    <Sources />
    <Stories />
    <Quote />
    <Shift />
    <Govern />
    <Cta />
  </main>
  <Footer />
</ProposalCLayout>
