---
/** Layout for proposal C: dark green, photography, Manrope. */
import '@fontsource-variable/manrope/wght.css';
import '../styles/proposal-c.css';
import '../styles/reveal.css';
import manrope from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import IterationTabs from '../components/IterationTabs.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#0d1b15" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preload" href={manrope} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}proposal-c/grass-wind-2400.webp`} as="image" media="(min-width: 1000px)" />
    <link rel="preload" href={`${import.meta.env.BASE_URL}proposal-c/grass-wind-1200.webp`} as="image" media="(max-width: 999px)" />
    <script is:inline>
      // Before first paint: hide the words that will be revealed, only if motion is welcome.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window)
        document.documentElement.classList.add('pc-js', 'rv-js');
    </script>
  </head>
  <body class="pc">
    <slot />
    <IterationTabs current="c" />
    <script>
      import { mountReveal } from '../scripts/reveal';
      import { mountStack } from '../scripts/stack';
      import { mountScrollFx } from '../scripts/proposal-c/scroll-fx';
      mountReveal();
      mountStack();
      mountScrollFx();
    </script>
  </body>
</html>
